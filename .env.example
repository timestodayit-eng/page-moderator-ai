# ───────────── Core ─────────────
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Page Moderator AI"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pm_dev
REDIS_URL=redis://localhost:6379
# 32 bytes base64:  openssl rand -base64 32
ENCRYPTION_KEY=
# Optional: previous key during rotation
ENCRYPTION_KEY_PREVIOUS=
SESSION_TTL_HOURS=336
SECURE_COOKIES=false
TRUST_PROXY=false

# ───────────── Meta / Facebook ─────────────
META_APP_ID=
META_APP_SECRET=
# At least 16 random characters:  openssl rand -hex 16
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0
META_SCOPES=pages_show_list,pages_read_engagement,pages_read_user_content,pages_manage_engagement,pages_manage_metadata,pages_messaging
# Global master switch. Automatic hide/reply/message actions stay disabled until this is true
# AND the Page admin enables automation per Page.
META_AUTOMATION_ENABLED=false

# ───────────── AI providers (platform-managed) ─────────────
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_REQUEST_TIMEOUT_MS=30000

# ───────────── Email ─────────────
# smtp | resend | postmark | disabled
EMAIL_PROVIDER=smtp
EMAIL_FROM="Page Moderator AI <no-reply@example.com>"
EMAIL_SUPPORT_ADDRESS=support@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# ───────────── Billing ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ───────────── Storage ─────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ───────────── Worker ─────────────
WORKER_CONCURRENCY=4
LOG_LEVEL=info
