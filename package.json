{
  "name": "page-moderator-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Page Moderator AI — Enterprise SaaS Studio: multi-tenant AI Facebook moderation, Messenger inbox, CRM and SaaS management",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && npm run build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/worker.mjs --packages=external --tsconfig=tsconfig.json --alias:@=./src",
    "start": "next start",
    "worker": "node dist/worker.mjs",
    "worker:dev": "tsx watch worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "env:check": "tsx scripts/check-env.ts",
    "eval:moderation": "tsx scripts/eval-moderation.ts",
    "db:migrate:wasm": "tsx scripts/prisma-wasm-migrate.ts deploy",
    "db:migrate:wasm:create": "tsx scripts/prisma-wasm-migrate.ts create",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/hind-siliguri": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "5.81.5",
    "clsx": "2.1.1",
    "dotenv": "17.2.3",
    "ioredis": "5.11.1",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "nodemailer": "7.0.13",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@prisma/driver-adapter-utils": "7.10.1",
    "@prisma/schema-engine-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "type": "module"
}
